Subject: [PATCH] Optimisation du dernier commit

---
 .../Donations/DonationSplitsProjectTable.php  |  10 +-
 operations/codex-init.md                      |  93 +++++++++++++++
 operations/init.ps1                           | 108 ++++++++++++++++++
 3 files changed, 209 insertions(+), 2 deletions(-)
 create mode 100644 operations/codex-init.md
 create mode 100644 operations/init.ps1

diff --git a/app/Http/Livewire/Tables/Donations/DonationSplitsProjectTable.php b/app/Http/Livewire/Tables/Donations/DonationSplitsProjectTable.php
index 2e9f424..6c8e064 100644
--- a/app/Http/Livewire/Tables/Donations/DonationSplitsProjectTable.php
+++ b/app/Http/Livewire/Tables/Donations/DonationSplitsProjectTable.php
@@ -34,13 +34,19 @@ class DonationSplitsProjectTable extends Component implements HasForms, HasTable
 
     protected function getTableQuery(): Builder
     {
-        return DonationSplit::with([
+        return DonationSplit::query()
+            ->select('donation_splits.*')
+            ->selectRaw(
+                'CASE WHEN project_id = ? THEN 1 ELSE 0 END as is_direct_project',
+                [$this->project->getKey()],
+            )
+            ->with([
             'donation.related',
             'childrenSplits',
         ])->withCount([
             'childrenSplits',
         ])->whereIn('project_id', $this->project->descendantAndSelfIds())
-            ->orderByRaw('CASE WHEN project_id = ? THEN 0 ELSE 1 END', [$this->project->id])
+            ->orderByDesc('is_direct_project')
             ->orderByDesc('created_at');
     }
